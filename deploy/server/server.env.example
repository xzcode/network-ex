# Development template. Install does not start or enable the service.
# Root-owned file, mode 0640, group network-ex-server.
NEX_MODE=all
NEX_NODE=relay1
NEX_LISTEN=127.0.0.1:8443
NEX_DB=/var/lib/network-ex-server/network.db
NEX_TLS_CERT=/etc/network-ex-server/tls.crt
NEX_TLS_KEY=/etc/network-ex-server/tls.key
NEX_ISSUER_KEY=/var/lib/network-ex-server/issuer.key
# Use your actual TLS origin and endpoint before starting.
NEX_RELAY_URL=wss://network.example.invalid/relay/v1
# Optional: NEX_STUN_URL=stun:network.example.invalid:3478
# Optional: NEX_STUN_LISTEN=127.0.0.1:3478
# Separate relay mode instead uses:
# NEX_ISSUER_PUBLIC=/etc/network-ex-server/issuer.pub
# NEX_MANAGEMENT_URL=https://network.example.invalid
# NEX_MANAGEMENT_CA=/etc/network-ex-server/control-ca.pem
# NEX_NODE_KEY=/var/lib/network-ex-server/relay.key
# NEX_NODE_INVITE_FILE=/var/lib/network-ex-server/node-invite
