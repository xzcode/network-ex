#!/usr/bin/env bash
set -euo pipefail
# Environment is supplied by the root-owned systemd EnvironmentFile.
# No eval, shell expansion of file contents, or credentials on the command line.
BIN=/usr/local/libexec/network-ex-server/network-ex-server
: "${NEX_MODE:?Set NEX_MODE}"
: "${NEX_NODE:?Set NEX_NODE}"
: "${NEX_TLS_CERT:?Set NEX_TLS_CERT}"
: "${NEX_TLS_KEY:?Set NEX_TLS_KEY}"
listen="${NEX_LISTEN:-127.0.0.1:8443}"
args=(-mode "$NEX_MODE" -node "$NEX_NODE" -listen "$listen" -tls-cert "$NEX_TLS_CERT" -tls-key "$NEX_TLS_KEY")
case "$NEX_MODE" in
 all|management)
  : "${NEX_DB:=/var/lib/network-ex-server/network.db}"
  : "${NEX_ISSUER_KEY:?Set NEX_ISSUER_KEY}"
  args+=(-db "$NEX_DB" -issuer-key "$NEX_ISSUER_KEY")
  if [[ -n "${NEX_RELAY_URL:-}" ]]; then args+=(-relay-url "$NEX_RELAY_URL"); fi
  if [[ "$NEX_MODE" == all ]];then : "${NEX_RELAY_URL:?all mode requires a WSS relay URL}";fi
  if [[ -n "${NEX_STUN_URL:-}" ]]; then args+=(-stun-url "$NEX_STUN_URL"); fi
  ;;
 relay)
  : "${NEX_ISSUER_PUBLIC:?Set NEX_ISSUER_PUBLIC}"
  args+=(-issuer-public "$NEX_ISSUER_PUBLIC")
  if [[ -n "${NEX_MANAGEMENT_URL:-}" ]]; then
   : "${NEX_NODE_KEY:?Registered relay needs its own private identity key}"
   args+=(-management-url "$NEX_MANAGEMENT_URL" -node-key "$NEX_NODE_KEY")
   if [[ -n "${NEX_MANAGEMENT_CA:-}" ]];then args+=(-management-ca "$NEX_MANAGEMENT_CA");fi
   if [[ -n "${NEX_NODE_INVITE_FILE:-}" ]];then args+=(-node-invite-file "$NEX_NODE_INVITE_FILE");fi
  fi
  ;;
 *) echo "Invalid NEX_MODE" >&2;exit 2;;
esac
if [[ -n "${NEX_STUN_LISTEN:-}" ]];then
 [[ "$NEX_MODE" != management ]]||{ echo "Management-only mode cannot listen for STUN" >&2;exit 2; }
 args+=(-stun-listen "$NEX_STUN_LISTEN")
fi
exec "$BIN" "${args[@]}"
